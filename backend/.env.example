# Local Docker Compose (port 5433 avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgresql://backtester:backtester@localhost:5433/backtester

# Or set POSTGRES_* parts (used by Render when DATABASE_URL is unset):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_USER=backtester
# POSTGRES_PASSWORD=backtester
# POSTGRES_DB=backtester

# Environment: MUST be set explicitly for local DX.
# Missing APP_ENV/ENV defaults to prod (fail-closed CORS).
# Local CORS defaults only when APP_ENV=dev or APP_ENV=local.
APP_ENV=dev
# ENV=dev

# API — CORS_ORIGINS required outside explicit APP_ENV=dev|local (no localhost default)
# CORS_ORIGINS=https://your-app.vercel.app
# CORS_ALLOW_LOCALHOST=true  # only for local Vite; default on in APP_ENV=dev, off otherwise

# Compute / abuse caps
# SCAN_MAX_SYMBOLS=50
# BACKTEST_MAX_WINDOW_SEC=31536000
# AI_MAX_RPM=30
# WS_MAX_CONNECTIONS_PER_USER=5

# Phase 10 AI — NL → DSL (never commit real keys)
# AI_LLM_PROVIDER=mock              # mock | openai_compat (auto: mock if no key)
# AI_LLM_API_KEY=sk-...
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_MODEL=gpt-4o-mini
# AI_LLM_TIMEOUT_SEC=60
# AI_CLARIFY_TTL_MINUTES=30
