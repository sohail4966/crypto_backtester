# Local Docker Compose (port 5433 avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgresql://backtester:backtester@localhost:5433/backtester

# Or set POSTGRES_* parts (used by Render when DATABASE_URL is unset):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5433
# POSTGRES_USER=backtester
# POSTGRES_PASSWORD=backtester
# POSTGRES_DB=backtester

# API (production: set CORS_ORIGINS to your Vercel URL)
# CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# CORS_ALLOW_LOCALHOST=true  # allow http://localhost:<any-port> for local Vite dev

# Phase 10 AI — NL → DSL (never commit real keys)
# AI_LLM_PROVIDER=mock              # mock | openai_compat (auto: mock if no key)
# AI_LLM_API_KEY=sk-...
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_MODEL=gpt-4o-mini
# AI_LLM_TIMEOUT_SEC=60
# AI_CLARIFY_TTL_MINUTES=30
